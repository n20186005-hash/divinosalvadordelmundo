---
import '../styles/global.css';

const attraction = {
  name: 'Monumento al Divino Salvador del Mundo',
  englishName: 'Monument to the Divine Savior of the World',
  city: 'San Salvador',
  country: 'El Salvador',
  address: 'Paseo General Escalón & Alameda Franklin Delano Roosevelt, San Salvador, El Salvador',
  phone: '+503 2511 6000',
  plusCode: 'PQ2G+G6 San Salvador, El Salvador',
  latitude: 13.701326586685262,
  longitude: -89.22700882308682,
  rating: 4.6,
  reviewCount: 21008,
};

const siteRoot = Astro.site ?? undefined;
const canonical = siteRoot ? new URL('/', siteRoot).toString() : undefined;
const ogImage = siteRoot ? new URL('/icons/og-card.svg', siteRoot).toString() : undefined;

const photos = [
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/3/37/Monumento_al_Salvador_del_Mundo_1.jpg/1280px-Monumento_al_Salvador_del_Mundo_1.jpg',
    alt: 'Vista amplia del Monumento al Divino Salvador del Mundo en San Salvador',
    author: 'Frankjh',
    license: 'CC BY-SA 3.0',
    href: 'https://commons.wikimedia.org/wiki/File:Monumento_al_Salvador_del_Mundo_1.jpg',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Monumento_al_Divino_Salvador_del_Mundo.JPG/1280px-Monumento_al_Divino_Salvador_del_Mundo.JPG',
    alt: 'Monumento al Divino Salvador del Mundo bajo el cielo de San Salvador',
    author: 'Erickssonr',
    license: 'CC BY-SA 3.0',
    href: 'https://commons.wikimedia.org/wiki/File:Monumento_al_Divino_Salvador_del_Mundo.JPG',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/b/b4/Monumento_al_Divino_Salvador_del_Mundo_-_Plaza_Salvador_del_Mundo.JPG/960px-Monumento_al_Divino_Salvador_del_Mundo_-_Plaza_Salvador_del_Mundo.JPG',
    alt: 'Perspectiva vertical del pedestal y la escultura del Divino Salvador del Mundo',
    author: 'Oskpal777',
    license: 'CC BY-SA 3.0',
    href: 'https://commons.wikimedia.org/wiki/File:Monumento_al_Divino_Salvador_del_Mundo_-_Plaza_Salvador_del_Mundo.JPG',
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/84/Monumento_al_Divino_Salvador_del_Mundo_en_El_Salvador.jpg/1280px-Monumento_al_Divino_Salvador_del_Mundo_en_El_Salvador.jpg',
    alt: 'Monumento iluminado durante las fiestas de agosto de San Salvador',
    author: 'Alex Bonilla',
    license: 'CC BY-SA 3.0',
    href: 'https://commons.wikimedia.org/wiki/File:Monumento_al_Divino_Salvador_del_Mundo_en_El_Salvador.jpg',
  },
];

const faqs = [
  {
    q: '¿Se paga entrada para visitar el Monumento al Divino Salvador del Mundo?',
    a: 'No hay una entrada turística fija para acceder a la plaza. Es un espacio urbano abierto; actividades o eventos especiales pueden tener su propia organización.',
  },
  {
    q: '¿Cuál es el mejor momento para visitarlo?',
    a: 'La luz de primera hora y la tarde suele favorecer las fotografías y evita el sol más fuerte. Al anochecer, la iluminación urbana ofrece otra lectura del monumento.',
  },
  {
    q: '¿Cuánto tiempo conviene reservar?',
    a: 'Entre 30 y 60 minutos suele ser suficiente para recorrer la plaza, observar el conjunto y tomar fotografías. Puede integrarse fácilmente con otros puntos de San Salvador.',
  },
  {
    q: '¿Hay estacionamiento dentro de la plaza?',
    a: 'No conviene asumir que existe estacionamiento turístico dedicado dentro del monumento. La opción práctica es utilizar estacionamientos privados cercanos o llegar en transporte por aplicación y verificar siempre la señalización vigente.',
  },
  {
    q: '¿Por qué es un símbolo nacional?',
    a: 'La figura de Cristo sobre el globo se ha convertido en una de las imágenes urbanas más reconocibles de El Salvador y funciona como punto cívico, religioso y de encuentro en la capital.',
  },
];

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  name: attraction.name,
  alternateName: attraction.englishName,
  ...(canonical ? { url: canonical } : {}),
  description: 'Monumento emblemático de San Salvador con la figura de Cristo sobre un globo terráqueo, inaugurado en 1942 y situado en la Plaza Salvador del Mundo.',
  telephone: attraction.phone,
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Paseo General Escalón & Alameda Franklin Delano Roosevelt',
    addressLocality: attraction.city,
    addressCountry: 'SV',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: attraction.rating,
    reviewCount: attraction.reviewCount,
    bestRating: 5,
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang="es-SV">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Guía independiente para visitar el Monumento al Divino Salvador del Mundo: historia, arquitectura, horarios, costos, transporte, estacionamiento, fotos y lugares cercanos." />
    <meta name="theme-color" content="#0b4592" />
    <title>Monumento al Divino Salvador del Mundo | Guía de visita en San Salvador</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_SV" />
    <meta property="og:title" content="Monumento al Divino Salvador del Mundo | Guía de visita" />
    <meta property="og:description" content="Historia, arquitectura y guía práctica del gran símbolo urbano de San Salvador." />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header" data-header>
      <a class="brand" href="#inicio" aria-label="Ir al inicio">
        <img src="/icons/logo.svg" alt="" width="206" height="54" />
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-principal" data-nav-toggle>
        <span></span><span></span><span></span>
        <span class="sr-only">Abrir navegación</span>
      </button>
      <nav id="nav-principal" class="main-nav" aria-label="Navegación principal" data-nav>
        <a href="#historia">Historia</a>
        <a href="#visita">Visita</a>
        <a href="#llegar">Cómo llegar</a>
        <a href="#alrededores">Alrededores</a>
        <a href="#faq">FAQ</a>
      </nav>
    </header>

    <main id="contenido">
      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <img class="hero-photo" src={photos[0].src} alt={photos[0].alt} fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">San Salvador · El Salvador</p>
          <h1 id="hero-title">El Salvador del Mundo</h1>
          <p class="hero-lead">Cristo sobre el mundo. Una imagen monumental que resume fe, memoria urbana e identidad salvadoreña en el corazón de la capital.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#visita">Planear la visita</a>
            <a class="button button-ghost" href="#historia">Conocer su historia</a>
          </div>
        </div>
        <div class="hero-credit">
          Foto: {photos[0].author} · {photos[0].license}
        </div>
        <div class="hero-seal" aria-hidden="true">
          <span class="seal-globe"></span>
          <span class="seal-axis"></span>
          <span class="seal-base"></span>
        </div>
      </section>

      <section class="fact-band" aria-label="Información esencial">
        <div>
          <span>Horario</span>
          <strong>Abierto 24 horas</strong>
        </div>
        <div>
          <span>Entrada</span>
          <strong>Acceso gratuito</strong>
        </div>
        <div>
          <span>Tiempo sugerido</span>
          <strong>30–60 min</strong>
        </div>
        <div>
          <span>Mejor luz</span>
          <strong>Mañana y atardecer</strong>
        </div>
      </section>

      <section id="historia" class="section section-story paper-grid">
        <div class="section-heading">
          <p class="section-kicker">1942 — hoy</p>
          <h2>Un monumento que terminó representando a todo un país</h2>
        </div>
        <div class="story-layout">
          <div class="story-copy prose">
            <p class="lede">La Plaza Salvador del Mundo fue construida en 1942 para el Primer Congreso Eucarístico Nacional. En su centro se elevó el conjunto que hoy identifica a San Salvador: una figura de Cristo, de mármol de Carrara, sobre un globo terráqueo y un alto pedestal.</p>
            <p>La escultura había sido encargada en memoria del expresidente Manuel Enrique Araujo y, antes de llegar a la plaza, estuvo vinculada a su monumento funerario y al Seminario San José de la Montaña. Con el tiempo, su ubicación en una de las principales intersecciones de la capital transformó la obra en referencia cívica y punto de encuentro.</p>
            <p>El terremoto de 1986 derribó y dañó gravemente la estatua. Fue reconstruida y volvió a ocupar su posición elevada. En 2012, la plaza recibió reconocimiento formal como Bien Cultural de El Salvador.</p>
          </div>
          <aside class="timeline" aria-label="Hitos históricos">
            <div class="timeline-item"><b>1942</b><span>Construcción de la plaza e instalación del monumento.</span></div>
            <div class="timeline-item"><b>1986</b><span>El terremoto derriba la escultura; posteriormente es restaurada.</span></div>
            <div class="timeline-item"><b>2012</b><span>La Plaza Salvador del Mundo es declarada Bien Cultural.</span></div>
          </aside>
        </div>
      </section>

      <section class="section monument-anatomy" aria-labelledby="arquitectura-title">
        <div class="anatomy-visual" aria-hidden="true">
          <div class="figure-mark">✦</div>
          <div class="globe-orbit"><div class="globe-core"></div></div>
          <div class="pedestal-mark"></div>
          <div class="plinth-mark"></div>
        </div>
        <div class="anatomy-copy">
          <p class="section-kicker">Arquitectura & símbolo</p>
          <h2 id="arquitectura-title">Una composición vertical: tierra, pedestal y figura</h2>
          <p>La lectura visual es inmediata. El globo azul y blanco concentra la mirada; encima se recorta la figura de Cristo, mientras el pedestal blanco la separa del tránsito y del horizonte urbano. Más que un edificio, es una pieza de monumentalidad cívico-religiosa diseñada para verse a distancia.</p>
          <dl class="detail-list">
            <div><dt>Material destacado</dt><dd>Escultura de mármol de Carrara</dd></div>
            <div><dt>Lenguaje</dt><dd>Monumentalismo con simbolismo religioso</dd></div>
            <div><dt>Composición</dt><dd>Eje vertical sobre plaza de traza romboidal</dd></div>
            <div><dt>Valor cultural</dt><dd>Emblema visual de San Salvador y El Salvador</dd></div>
          </dl>
        </div>
      </section>

      <section id="visita" class="section visit-section">
        <div class="section-heading narrow">
          <p class="section-kicker">Visita práctica</p>
          <h2>Cómo recorrer la plaza sin perder su mejor perspectiva</h2>
          <p>El monumento se disfruta mejor como una secuencia de vistas: primero desde el borde urbano, después desde el eje del pedestal y finalmente desde los laterales de la plaza.</p>
        </div>
        <div class="route-grid">
          <article><span>01</span><h3>Llegada y vista general</h3><p>Detente en un punto seguro del perímetro para leer el conjunto completo y su relación con las grandes avenidas.</p></article>
          <article><span>02</span><h3>Eje frontal</h3><p>Acércate por los senderos de la plaza. El pedestal gana escala y la esfera se vuelve el centro de la composición.</p></article>
          <article><span>03</span><h3>Giro lateral</h3><p>Rodea el monumento para buscar el perfil de Cristo y separar la silueta del fondo urbano.</p></article>
          <article><span>04</span><h3>Luz de cierre</h3><p>Si visitas al final de la tarde, reserva unos minutos para el cambio de luz y la iluminación nocturna.</p></article>
        </div>

        <div class="visit-cards">
          <article class="info-card"><p class="card-label">Horario</p><h3>24 horas</h3><p>La plaza se presenta como espacio público abierto. En eventos, pueden existir cierres parciales o controles temporales.</p></article>
          <article class="info-card"><p class="card-label">Entrada / costos</p><h3>Sin boleto fijo</h3><p>La visita al monumento no requiere una tarifa turística regular. Presupuesta solamente transporte, estacionamiento o consumos cercanos.</p></article>
          <article class="info-card"><p class="card-label">Mejor momento</p><h3>Mañana o atardecer</h3><p>Menos calor, luz más lateral y mejores contrastes en el pedestal blanco y la esfera azul.</p></article>
          <article class="info-card"><p class="card-label">Estancia sugerida</p><h3>30–60 minutos</h3><p>Suficiente para caminar, fotografiar y entender el monumento; amplía el tiempo si combinas la visita con el entorno.</p></article>
        </div>
      </section>

      <section class="section photo-section" aria-labelledby="fotos-title">
        <div class="section-heading">
          <p class="section-kicker">Fotografía</p>
          <h2 id="fotos-title">Tres encuadres para entender su escala</h2>
        </div>
        <div class="photo-grid">
          {photos.slice(1).map((photo, index) => (
            <figure class:list={['photo-frame', index === 1 && 'photo-frame-tall']}>
              <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
              <figcaption>
                <span>{index === 0 ? 'Frontal · esfera y pedestal' : index === 1 ? 'Vertical · monumentalidad' : 'Nocturna · fiestas de agosto'}</span>
                <a href={photo.href} target="_blank" rel="license noopener">{photo.author} · {photo.license}</a>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="photo-tip">
          <strong>Consejo de encuadre</strong>
          <p>Para una imagen limpia, usa el pedestal como eje y deja aire sobre la figura. En tomas abiertas, incorpora el borde de la plaza para mostrar la escala urbana. Evita fotografiar desde la calzada: el tráfico alrededor de la plaza es intenso.</p>
        </div>
      </section>

      <section id="llegar" class="section transport-section">
        <div class="transport-intro">
          <p class="section-kicker">Cómo llegar</p>
          <h2>En una de las intersecciones más reconocibles de San Salvador</h2>
          <p>La plaza está en el encuentro del Paseo General Escalón y la Alameda Franklin Delano Roosevelt, conectada con ejes principales de la capital.</p>
        </div>
        <div class="transport-grid">
          <article>
            <h3>Transporte por aplicación / taxi</h3>
            <p>Es la opción más sencilla si no conoces la circulación local. Indica “Plaza Salvador del Mundo” y acuerda un punto seguro para descender sin detenerte en carriles de flujo rápido.</p>
          </article>
          <article>
            <h3>Autobús</h3>
            <p>Varias rutas urbanas pasan por los corredores cercanos. Como los recorridos pueden cambiar, confirma la ruta y el sentido el mismo día con un servicio local de mapas o con el operador.</p>
          </article>
          <article>
            <h3>En vehículo</h3>
            <p>Llega por Paseo General Escalón o Alameda Roosevelt y anticipa el carril necesario. El entorno funciona como nodo vial y puede congestionarse en horas de mayor movimiento.</p>
          </article>
          <article>
            <h3>Estacionamiento</h3>
            <p>No cuentes con un estacionamiento turístico dedicado dentro de la plaza. Prefiere estacionamientos privados del entorno y respeta señalización, accesos y restricciones vigentes.</p>
          </article>
        </div>
        <div class="address-panel">
          <div>
            <span>Dirección</span>
            <strong>{attraction.address}</strong>
          </div>
          <div><span>Plus Code</span><strong>{attraction.plusCode}</strong></div>
          <a class="button button-dark" href="https://maps.app.goo.gl/dJbRbbEYndvHH2kDA" target="_blank" rel="noopener">Abrir en Google Maps</a>
        </div>
        <div class="map-wrap">
          <iframe
            title="Mapa de la Plaza Salvador del Mundo"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6632.077258421091!2d-89.22700882308682!3d13.701326586685262!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f6330410eacae2d%3A0xf3bd10411c7f3afb!2sMonument%20to%20the%20Divine%20Savior%20of%20the%20World!5e1!3m2!1ses!2ssv!4v1788749288171!5m2!1ses!2ssv&hl=es&region=SV"
            width="600"
            height="450"
            style="border:0;"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <section id="alrededores" class="section around-section paper-grid">
        <div class="section-heading">
          <p class="section-kicker">Alrededores</p>
          <h2>Completa la visita con ciudad, cultura y cocina salvadoreña</h2>
        </div>
        <div class="around-columns">
          <div>
            <h3>Qué comer cerca</h3>
            <div class="around-list">
              <article><span>01</span><div><h4>Cocina salvadoreña</h4><p>Busca pupusas, yuca, panes con pollo y desayunos típicos en la zona de Escalón y corredores cercanos.</p></div></article>
              <article><span>02</span><div><h4>Café y sobremesa</h4><p>San Salvador tiene una fuerte cultura de café; la zona occidental de la capital reúne cafeterías y opciones para una pausa antes o después de la plaza.</p></div></article>
              <article><span>03</span><div><h4>Opciones internacionales</h4><p>Alrededor de Escalón y San Benito encontrarás restaurantes casuales y de mesa de distintas cocinas, útiles para combinar con una visita corta.</p></div></article>
            </div>
          </div>
          <div>
            <h3>Qué ver después</h3>
            <div class="around-list">
              <article><span>01</span><div><h4>Parque Cuscatlán</h4><p>Gran espacio verde urbano sobre la Alameda Roosevelt, adecuado para continuar a pie o en un traslado corto.</p></div></article>
              <article><span>02</span><div><h4>Museo de Arte de El Salvador</h4><p>Una buena continuación para entender el arte salvadoreño moderno y contemporáneo en la zona de San Benito.</p></div></article>
              <article><span>03</span><div><h4>Centro Histórico de San Salvador</h4><p>Plazas, arquitectura cívica y templos permiten ampliar la lectura histórica de la capital en una segunda parada.</p></div></article>
            </div>
          </div>
        </div>
      </section>

      <section class="section stay-section" aria-labelledby="alojamiento-title">
        <div class="stay-copy">
          <p class="section-kicker">Dónde alojarse</p>
          <h2 id="alojamiento-title">Escalón para practicidad; San Benito para cultura y vida urbana</h2>
          <p>Si el monumento forma parte de una estancia corta en la capital, Escalón resulta práctico por su cercanía y conexiones. San Benito ofrece una base cómoda para combinar museos, restaurantes y otros puntos del oeste de San Salvador.</p>
          <p class="muted">Antes de reservar, compara acceso vehicular, estacionamiento del alojamiento y tiempos reales de traslado en la franja horaria que planeas usar.</p>
        </div>
        <div class="stay-mark" aria-hidden="true"><span></span><b>SV</b></div>
      </section>

      <section id="faq" class="section faq-section">
        <div class="section-heading narrow">
          <p class="section-kicker">Preguntas frecuentes</p>
          <h2>Lo esencial antes de ir</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section source-section" aria-labelledby="fuentes-title">
        <div>
          <p class="section-kicker">Fuentes & créditos</p>
          <h2 id="fuentes-title">Información trazable, fotografías con licencia abierta</h2>
        </div>
        <div class="source-copy">
          <p>La reseña histórica se apoya en publicaciones del Ministerio de Cultura de El Salvador, material educativo institucional y fuentes universitarias. Los datos prácticos pueden cambiar por eventos, obras o regulación local; compruébalos antes de tu visita.</p>
          <p>Las fotografías mostradas proceden de Wikimedia Commons y conservan atribución y licencia CC BY-SA 3.0. Consulta <a href="/PHOTO-SOURCES.md">PHOTO-SOURCES.md</a> en el paquete del proyecto para los enlaces de origen.</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img src="/icons/favicon.svg" width="46" height="46" alt="" />
        <div><strong>Salvador del Mundo</strong><span>Guía independiente de visita</span></div>
      </div>
      <div class="footer-links">
        <button type="button" data-open-dialog="privacy">Privacidad</button>
        <button type="button" data-open-dialog="terms">Términos</button>
        <button type="button" data-open-dialog="cookies">Cookies</button>
      </div>
      <p class="disclaimer">Sitio informativo independiente; no es el sitio oficial de la Alcaldía de San Salvador, del Ministerio de Cultura ni de la administración de la plaza.</p>
    </footer>

    <div class="cookie-banner" data-cookie-banner hidden>
      <div><strong>Preferencias de medición</strong><p>Usamos Google Analytics solo si aceptas cookies de analítica. Las necesarias para recordar tu elección no requieren consentimiento.</p></div>
      <div class="cookie-actions">
        <button class="button button-primary" type="button" data-cookie-accept>Aceptar analítica</button>
        <button class="button button-ghost-dark" type="button" data-cookie-reject>Solo necesarias</button>
        <button class="text-button" type="button" data-open-dialog="cookies">Configurar</button>
      </div>
    </div>

    <dialog id="privacy" class="legal-dialog">
      <div class="dialog-inner">
        <button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar">×</button>
        <p class="section-kicker">Privacidad</p>
        <h2>Política de privacidad</h2>
        <p>Este sitio es informativo y no solicita cuentas, formularios de registro ni datos de pago. Si autorizas analítica, Google Analytics 4 puede recibir datos técnicos y de uso de acuerdo con su propia política.</p>
        <p>La preferencia de cookies se guarda localmente en tu navegador. Puedes cambiarla desde “Cookies” en el pie de página.</p>
      </div>
    </dialog>

    <dialog id="terms" class="legal-dialog">
      <div class="dialog-inner">
        <button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar">×</button>
        <p class="section-kicker">Términos</p>
        <h2>Términos de uso</h2>
        <p>La información se ofrece como orientación general para visitantes. Horarios, accesos, transporte, estacionamiento, eventos y condiciones del espacio público pueden cambiar sin aviso.</p>
        <p>Verifica la información crítica con fuentes oficiales o servicios locales antes de desplazarte. Las marcas y nombres de terceros pertenecen a sus respectivos titulares.</p>
      </div>
    </dialog>

    <dialog id="cookies" class="legal-dialog">
      <div class="dialog-inner">
        <button class="dialog-close" type="button" data-close-dialog aria-label="Cerrar">×</button>
        <p class="section-kicker">Cookies</p>
        <h2>Configuración de cookies</h2>
        <div class="preference-row"><div><strong>Necesarias</strong><p>Guardan tu preferencia de privacidad.</p></div><span>Siempre activas</span></div>
        <div class="preference-row"><div><strong>Analítica</strong><p>Google Analytics 4 (G-HXM22WWPKP), solo con consentimiento.</p></div><label class="switch"><input type="checkbox" data-analytics-toggle /><span></span></label></div>
        <button class="button button-primary" type="button" data-save-preferences>Guardar preferencias</button>
      </div>
    </dialog>

    <script is:inline>
      (() => {
        const GA_ID = 'G-HXM22WWPKP';
        const COOKIE_KEY = 'salvador-mundo-analytics-consent';
        let analyticsLoaded = false;

        const loadAnalytics = () => {
          if (analyticsLoaded || document.querySelector('script[data-ga4]')) return;
          analyticsLoaded = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          script.dataset.ga4 = 'true';
          document.head.appendChild(script);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', GA_ID, { anonymize_ip: true });
        };

        const setConsent = (allowed) => {
          localStorage.setItem(COOKIE_KEY, allowed ? 'granted' : 'denied');
          const toggle = document.querySelector('[data-analytics-toggle]');
          if (toggle) toggle.checked = allowed;
          const banner = document.querySelector('[data-cookie-banner]');
          if (banner) banner.hidden = true;
          if (allowed) loadAnalytics();
        };

        const stored = localStorage.getItem(COOKIE_KEY);
        const banner = document.querySelector('[data-cookie-banner]');
        if (!stored && banner) banner.hidden = false;
        if (stored === 'granted') loadAnalytics();

        document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => setConsent(true));
        document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => setConsent(false));

        const analyticsToggle = document.querySelector('[data-analytics-toggle]');
        if (analyticsToggle) analyticsToggle.checked = stored === 'granted';
        document.querySelector('[data-save-preferences]')?.addEventListener('click', () => {
          setConsent(Boolean(analyticsToggle?.checked));
          document.querySelector('#cookies')?.close();
        });

        document.querySelectorAll('[data-open-dialog]').forEach((button) => {
          button.addEventListener('click', () => {
            const id = button.getAttribute('data-open-dialog');
            const dialog = id ? document.getElementById(id) : null;
            if (dialog?.showModal) dialog.showModal();
          });
        });
        document.querySelectorAll('[data-close-dialog]').forEach((button) => {
          button.addEventListener('click', () => button.closest('dialog')?.close());
        });
        document.querySelectorAll('dialog').forEach((dialog) => {
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
        });

        const toggle = document.querySelector('[data-nav-toggle]');
        const nav = document.querySelector('[data-nav]');
        toggle?.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!open));
          nav?.classList.toggle('is-open', !open);
        });
        nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          nav.classList.remove('is-open');
        }));
      })();
    </script>
  </body>
</html>
