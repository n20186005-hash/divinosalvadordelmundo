---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ATTRACTION,
  GUIDES,
  PHOTOS,
  RATING_DISPLAY,
  REVIEW_DISPLAY,
} from '../data/site';
import { HOME_FAQS } from '../data/faqs';
import {
  buildAttractionSchema,
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildWebPageSchema,
} from '../lib/schema';

const pageTitle = 'Monumento al Divino Salvador del Mundo: historia, cómo llegar y fotos';
const pageDescription =
  'El Monumento al Divino Salvador del Mundo en San Salvador: historia, cómo llegar en bus o taxi, horario 24 h, acceso gratuito, fotos, mapa y lugares cercanos.';

const site = Astro.site;
const schema = [
  buildAttractionSchema(site),
  buildFaqSchema(HOME_FAQS),
  buildBreadcrumbSchema(site, [{ name: 'Inicio', path: '/' }]),
  buildWebPageSchema(site, '/', pageTitle, pageDescription),
];

const hero = PHOTOS.frontal;
const highlights = [PHOTOS.plaza, PHOTOS.vertical];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  preload={hero.src}
  schema={schema}
>
  <section id="inicio" class="hero" aria-labelledby="hero-title">
    <img
      class="hero-photo"
      src={hero.src}
      alt={hero.alt}
      width="1280"
      height="721"
      decoding="async"
    />
    <div class="hero-shade"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">Hito cívico-religioso · 1942 — hoy</p>
      <h1 id="hero-title">
        Monumento al Divino Salvador del Mundo<span class="hero-loc">San Salvador · El Salvador</span>
      </h1>
      <p class="hero-lead">
        Cristo sobre el mundo. Una imagen monumental que resume fe, memoria urbana e identidad
        salvadoreña en el corazón de la capital.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#visita">Planear la visita</a>
        <a class="button button-ghost" href="/historia/">Conocer su historia</a>
      </div>
    </div>
    <div class="hero-credit">Foto: {hero.author} · {hero.license}</div>
    <div class="hero-seal" aria-hidden="true">
      <span class="seal-globe"></span>
      <span class="seal-axis"></span>
      <span class="seal-base"></span>
    </div>
  </section>

  <section class="fact-band" aria-label="Información esencial">
    <div><span>Horario</span><strong>Abierto 24 horas</strong></div>
    <div><span>Entrada</span><strong>Acceso gratuito</strong></div>
    <div><span>Tiempo sugerido</span><strong>30–60 min</strong></div>
    <div><span>Valoración</span><strong>{RATING_DISPLAY}/5 · {REVIEW_DISPLAY} reseñas</strong></div>
  </section>

  <section id="acerca" class="section about-section" aria-labelledby="acerca-title">
    <div class="about-grid">
      <div class="prose">
        <p class="section-kicker">Acerca del monumento</p>
        <h2 id="acerca-title">Sobre el Monumento al Divino Salvador del Mundo en San Salvador</h2>
        <p class="lede">
          El <strong>Monumento al Divino Salvador del Mundo</strong> —en inglés
          <em>{ATTRACTION.englishName}</em>, nombre con el que figura en Google Maps— es el conjunto
          escultórico que preside la <strong>{ATTRACTION.commonName}</strong>, el hito central de
          <strong>{ATTRACTION.city}</strong>, capital de <strong>{ATTRACTION.country}</strong>. Su
          figura de Cristo sobre el globo resume, en una sola imagen, la relación entre la capital, la
          tradición religiosa y la identidad salvadoreña.
        </p>
        <p>
          La escultura de 1942 se eleva en una de las intersecciones más visibles de la ciudad: el
          cruce del <strong>Paseo General Escalón</strong> con la
          <strong>Alameda Franklin Delano Roosevelt</strong>, en plena Plaza Salvador del Mundo.
          Es una plaza pública abierta las 24 horas y de acceso gratuito.
        </p>
        <ul class="geo-chain" aria-label="Jerarquía geográfica del monumento">
          <li>{ATTRACTION.name}</li>
          <li>{ATTRACTION.city}</li>
          <li>{ATTRACTION.region}</li>
          <li>{ATTRACTION.country}</li>
        </ul>
        <p>
          Por su posición central, la visita se combina fácilmente con el
          <strong>Parque Cuscatlán</strong> y el <strong>Museo de Arte de El Salvador (MARTE)</strong>,
          o continúa en un traslado corto hacia el <strong>Centro Histórico de San Salvador</strong>.
        </p>
      </div>
      <aside class="nap-card" aria-label="Datos del monumento">
        <dl>
          <div><dt>Nombre</dt><dd>{ATTRACTION.name}</dd></div>
          <div><dt>Dirección</dt><dd>{ATTRACTION.address}</dd></div>
          <div>
            <dt>Teléfono</dt>
            <dd><a href={`tel:${ATTRACTION.phoneE164}`}>{ATTRACTION.phone}</a></dd>
          </div>
          <div><dt>Plus Code</dt><dd>{ATTRACTION.plusCode}</dd></div>
          <div><dt>Horario</dt><dd>Plaza abierta 24 h · acceso gratuito</dd></div>
          <div><dt>Valoración Google</dt><dd>{RATING_DISPLAY}/5 · {REVIEW_DISPLAY} reseñas</dd></div>
        </dl>
        <a class="button button-primary" href={ATTRACTION.mapsUrl} target="_blank" rel="noopener">
          Ver ubicación en Google Maps
        </a>
      </aside>
    </div>
  </section>

  <section id="historia" class="section section-story paper-grid">
    <div class="section-heading">
      <p class="section-kicker">1942 — hoy</p>
      <h2>Un monumento que terminó representando a todo un país</h2>
    </div>
    <div class="story-layout">
      <div class="story-copy prose">
        <p class="lede">
          La Plaza Salvador del Mundo se construyó en 1942 para el Primer Congreso Eucarístico
          Nacional. En su centro se elevó el conjunto que hoy identifica a San Salvador: una figura de
          Cristo, de mármol de Carrara, sobre un globo terráqueo y un alto pedestal.
        </p>
        <p>
          La escultura había sido encargada en memoria del expresidente Manuel Enrique Araujo y, antes
          de llegar a la plaza, estuvo vinculada a su monumento funerario. Con el tiempo, su ubicación
          en una de las principales intersecciones de la capital transformó la obra en referencia
          cívica y punto de encuentro. El terremoto de 1986 la derribó; fue reconstruida y en 2012 la
          plaza recibió reconocimiento como Bien Cultural.
        </p>
        <p>
          <a class="text-link" href="/historia/">Leer la historia completa del monumento →</a>
        </p>
      </div>
      <aside class="timeline" aria-label="Hitos históricos">
        <div class="timeline-item"><b>1942</b><span>Construcción de la plaza e instalación del monumento.</span></div>
        <div class="timeline-item"><b>1986</b><span>El terremoto derriba la escultura; posteriormente es restaurada.</span></div>
        <div class="timeline-item"><b>2012</b><span>La Plaza Salvador del Mundo es declarada Bien Cultural.</span></div>
      </aside>
    </div>
  </section>

  <section class="section monument-anatomy" aria-labelledby="arquitectura-title">
    <div class="anatomy-visual" aria-hidden="true">
      <div class="figure-mark">✦</div>
      <div class="globe-orbit"><div class="globe-core"></div></div>
      <div class="pedestal-mark"></div>
      <div class="plinth-mark"></div>
    </div>
    <div class="anatomy-copy">
      <p class="section-kicker">Arquitectura & símbolo</p>
      <h2 id="arquitectura-title">Una composición vertical: tierra, pedestal y figura</h2>
      <p>
        La lectura visual es inmediata. El globo azul y blanco concentra la mirada; encima se recorta
        la figura de Cristo, mientras el pedestal blanco la separa del tránsito y del horizonte
        urbano. Más que un edificio, es una pieza de monumentalidad cívico-religiosa diseñada para
        verse a distancia.
      </p>
      <dl class="detail-list">
        <div><dt>Material destacado</dt><dd>Escultura de mármol de Carrara</dd></div>
        <div><dt>Lenguaje</dt><dd>Monumentalismo con simbolismo religioso</dd></div>
        <div><dt>Composición</dt><dd>Eje vertical sobre plaza de traza romboidal</dd></div>
        <div><dt>Valor cultural</dt><dd>Emblema visual de San Salvador y El Salvador</dd></div>
      </dl>
    </div>
  </section>

  <section id="visita" class="section visit-section">
    <div class="section-heading narrow">
      <p class="section-kicker">Visita práctica</p>
      <h2>Cómo recorrer la plaza sin perder su mejor perspectiva</h2>
      <p>
        El monumento se disfruta mejor como una secuencia de vistas: primero desde el borde urbano,
        después desde el eje del pedestal y finalmente desde los laterales de la plaza.
      </p>
    </div>
    <div class="route-grid">
      <article><span>01</span><h3>Llegada y vista general</h3><p>Detente en un punto seguro del perímetro para leer el conjunto completo y su relación con las grandes avenidas.</p></article>
      <article><span>02</span><h3>Eje frontal</h3><p>Acércate por los senderos de la plaza. El pedestal gana escala y la esfera se vuelve el centro de la composición.</p></article>
      <article><span>03</span><h3>Giro lateral</h3><p>Rodea el monumento para buscar el perfil de Cristo y separar la silueta del fondo urbano.</p></article>
      <article><span>04</span><h3>Luz de cierre</h3><p>Si visitas al final de la tarde, reserva unos minutos para el cambio de luz y la iluminación nocturna.</p></article>
    </div>

    <div class="visit-cards">
      <article class="info-card"><p class="card-label">Horario</p><h3>24 horas</h3><p>La plaza funciona como espacio público abierto. En eventos, pueden existir cierres parciales o controles temporales.</p></article>
      <article class="info-card"><p class="card-label">Entrada / costos</p><h3>Gratuito</h3><p>La visita al monumento no requiere una tarifa turística regular. Presupuesta solamente transporte, estacionamiento o consumos cercanos.</p></article>
      <article class="info-card"><p class="card-label">Mejor momento</p><h3>Mañana o atardecer</h3><p>Menos calor, luz más lateral y mejores contrastes en el pedestal blanco y la esfera azul.</p></article>
      <article class="info-card"><p class="card-label">Estancia sugerida</p><h3>30–60 minutos</h3><p>Suficiente para caminar, fotografiar y entender el monumento; amplía el tiempo si combinas la visita con el entorno.</p></article>
    </div>
  </section>

  <section class="section photo-section" aria-labelledby="fotos-title">
    <div class="section-heading">
      <p class="section-kicker">Fotografía</p>
      <h2 id="fotos-title">Los encuadres que mejor explican su escala</h2>
    </div>
    <div class="photo-grid photo-grid-pair">
      {
        highlights.map((photo) => (
          <figure class="photo-frame">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              width="1280"
              height="960"
            />
            <figcaption>
              <span>{photo.alt}</span>
              <a href={photo.href} target="_blank" rel="license noopener">
                {photo.author} · {photo.license}
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <div class="photo-tip">
      <strong>Consejo de encuadre</strong>
      <p>
        Para una imagen limpia, usa el pedestal como eje y deja aire sobre la figura. Evita fotografiar
        desde la calzada: el tráfico alrededor de la plaza es intenso.
        <a class="text-link" href="/fotos/">Ver los cuatro miradores recomendados →</a>
      </p>
    </div>
  </section>

  <section id="llegar" class="section transport-section">
    <div class="transport-intro">
      <p class="section-kicker">Cómo llegar</p>
      <h2>En una de las intersecciones más reconocibles de San Salvador</h2>
      <p>
        La plaza está en el encuentro del Paseo General Escalón y la Alameda Franklin Delano
        Roosevelt, conectada con los ejes principales de la capital (Plus Code {ATTRACTION.plusCode}).
      </p>
    </div>
    <div class="transport-grid">
      <article>
        <h3>Transporte por aplicación / taxi</h3>
        <p>Es la opción más sencilla si no conoces la circulación local. Indica “Plaza Salvador del Mundo” y acuerda un punto seguro para descender sin detenerte en carriles de flujo rápido.</p>
      </article>
      <article>
        <h3>Autobús</h3>
        <p>Varias rutas urbanas pasan por los corredores Roosevelt, Escalón y Manuel Enrique Araujo. Como los recorridos pueden cambiar, confirma la ruta y el sentido el mismo día.</p>
      </article>
      <article>
        <h3>En vehículo</h3>
        <p>Llega por Paseo General Escalón o Alameda Roosevelt y anticipa el carril necesario. El entorno funciona como nodo vial y puede congestionarse en horas punta.</p>
      </article>
      <article>
        <h3>Estacionamiento</h3>
        <p>No cuentes con un estacionamiento turístico dedicado dentro de la plaza. Prefiere estacionamientos privados del entorno y respeta señalización, accesos y restricciones vigentes.</p>
      </article>
    </div>
    <div class="address-panel">
      <div class="address-main">
        <span>Dirección oficial</span>
        <strong>{ATTRACTION.name} — {ATTRACTION.street}</strong>
        <small>{ATTRACTION.city}, {ATTRACTION.country} · Plus Code {ATTRACTION.plusCode}</small>
      </div>
      <div class="address-meta">
        <div><span>Teléfono</span><strong>{ATTRACTION.phone}</strong></div>
        <div><span>Horario</span><strong>24 h · acceso gratuito</strong></div>
        <div><span>Valoración Google</span><strong>{RATING_DISPLAY}/5 · {REVIEW_DISPLAY} reseñas</strong></div>
      </div>
      <a class="button button-dark" href={ATTRACTION.mapsUrl} target="_blank" rel="noopener">
        Abrir en Google Maps
      </a>
    </div>
    <p class="map-cta">
      <a class="text-link" href="/como-llegar/">Cómo llegar en bus, taxi, auto o a pie (con detalle) →</a>
    </p>
    <div class="map-wrap">
      <iframe
        title="Mapa del Monumento al Divino Salvador del Mundo en San Salvador"
        src={ATTRACTION.mapsEmbedSrc}
        width="600"
        height="450"
        style="border:0;"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <div class="map-note">
      <p>
        Para información oficial y actualizaciones turísticas de la región, visita el
        <a href={ATTRACTION.tourismUrl} target="_blank" rel="noopener noreferrer">Portal Oficial de Turismo de El Salvador (El Salvador Travel)</a>
        y la página del
        <a href={ATTRACTION.culturaUrl} target="_blank" rel="noopener noreferrer">Ministerio de Cultura de El Salvador</a>.
      </p>
    </div>
  </section>

  <section id="alrededores" class="section around-section paper-grid">
    <div class="section-heading">
      <p class="section-kicker">Alrededores</p>
      <h2>Completa la visita con ciudad, cultura y cocina salvadoreña</h2>
    </div>
    <div class="around-columns">
      <div>
        <h3>Qué comer cerca</h3>
        <div class="around-list">
          <article><span>01</span><div><h4>Cocina salvadoreña</h4><p>Busca pupusas, yuca, panes con pollo y desayunos típicos en la zona de Escalón y corredores cercanos.</p></div></article>
          <article><span>02</span><div><h4>Café y sobremesa</h4><p>San Salvador tiene una fuerte cultura de café; la zona occidental de la capital reúne cafeterías y opciones para una pausa antes o después de la plaza.</p></div></article>
          <article><span>03</span><div><h4>Opciones internacionales</h4><p>Alrededor de Escalón y San Benito encontrarás restaurantes casuales y de mesa de distintas cocinas, útiles para combinar con una visita corta.</p></div></article>
        </div>
      </div>
      <div>
        <h3>Qué ver después</h3>
        <div class="around-list">
          <article><span>01</span><div><h4>Parque Cuscatlán</h4><p>Gran espacio verde urbano sobre la Alameda Roosevelt, adecuado para continuar a pie o en un traslado corto.</p></div></article>
          <article><span>02</span><div><h4>Museo de Arte de El Salvador</h4><p>Una buena continuación para entender el arte salvadoreño moderno y contemporáneo en la zona de San Benito.</p></div></article>
          <article><span>03</span><div><h4>Centro Histórico de San Salvador</h4><p>Plazas, arquitectura cívica y templos permiten ampliar la lectura histórica de la capital en una segunda parada.</p></div></article>
        </div>
      </div>
    </div>
  </section>

  <section class="section stay-section" aria-labelledby="alojamiento-title">
    <div class="stay-copy">
      <p class="section-kicker">Dónde alojarse</p>
      <h2 id="alojamiento-title">Escalón para practicidad; San Benito para cultura y vida urbana</h2>
      <p>
        Si el monumento forma parte de una estancia corta en la capital, Escalón resulta práctico por
        su cercanía y conexiones. San Benito ofrece una base cómoda para combinar museos, restaurantes
        y otros puntos del oeste de San Salvador.
      </p>
      <p class="muted">
        Antes de reservar, compara acceso vehicular, estacionamiento del alojamiento y tiempos reales
        de traslado en la franja horaria que planeas usar.
      </p>
    </div>
    <div class="stay-mark" aria-hidden="true"><span></span><b>SV</b></div>
  </section>

  <section id="guias" class="section guides-section" aria-labelledby="guias-title">
    <div class="section-heading narrow">
      <p class="section-kicker">Lecturas recomendadas</p>
      <h2 id="guias-title">Profundiza en la historia, el acceso y la fotografía</h2>
    </div>
    <div class="related-grid">
      {
        GUIDES.map((guide) => (
          <a class="related-card" href={guide.href}>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
            <span>Leer →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section id="faq" class="section faq-section">
    <div class="section-heading narrow">
      <p class="section-kicker">Preguntas frecuentes</p>
      <h2>Lo esencial antes de ir</h2>
    </div>
    <div class="faq-list">
      {
        HOME_FAQS.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section id="fuentes" class="section source-section" aria-labelledby="fuentes-title">
    <div class="source-intro">
      <p class="section-kicker">Fuentes & créditos</p>
      <h2 id="fuentes-title">Información trazable, fotografías con licencia abierta</h2>
      <p class="source-note">
        La reseña histórica se apoya en publicaciones del Ministerio de Cultura de El Salvador,
        material educativo institucional y fuentes universitarias. Los datos prácticos pueden cambiar
        por eventos, obras o regulación local; compruébalos antes de tu visita.
      </p>
    </div>
    <div class="source-body">
      <h3>Fuentes oficiales y de referencia</h3>
      <ul class="source-links">
        <li>
          <a href={ATTRACTION.culturaUrl} target="_blank" rel="noopener noreferrer">Ministerio de Cultura de El Salvador</a>
          <span>Historia del monumento, de la plaza y declaratoria como Bien Cultural.</span>
        </li>
        <li>
          <a href={ATTRACTION.tourismUrl} target="_blank" rel="noopener noreferrer">El Salvador Travel — Portal oficial de turismo</a>
          <span>Información turística nacional y regional de El Salvador.</span>
        </li>
        <li>
          <a href={ATTRACTION.alcaldiaUrl} target="_blank" rel="noopener noreferrer">Alcaldía Municipal de San Salvador</a>
          <span>Información municipal de la capital.</span>
        </li>
        <li>
          <a href={ATTRACTION.mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps — Monumento al Divino Salvador del Mundo</a>
          <span>Ficha pública del lugar: dirección, teléfono y valoración {RATING_DISPLAY}/5 con {REVIEW_DISPLAY} reseñas.</span>
        </li>
      </ul>
      <h3>Créditos y propiedad de las fotografías</h3>
      <p>
        Todas las fotografías mostradas en este sitio web pertenecen a sus autores originales y su
        copyright se reserva a los fotógrafos; se publican con atribución y licencia CC BY-SA 3.0.
        Consulta <a href="/PHOTO-SOURCES.md">PHOTO-SOURCES.md</a> en el paquete del proyecto para los
        enlaces de origen de cada imagen.
      </p>
      <p class="source-note">
        Este sitio es una guía de visita independiente y no está afiliado a la administración del
        monumento ni a las instituciones citadas.
      </p>
    </div>
  </section>
</BaseLayout>
